<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Suzhou Story House · 觀心亭拾遺</title>
  <style>
    :root{--paper:#f1eee5;--ink:#1b1d1d;--muted:#73746f;--line:#c8c4b9;--pixel:6px;--block:#e7e2d6}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:Georgia,"Songti SC","Songti TC",STSong,SimSun,serif}
    body::before{content:"";position:fixed;inset:0;z-index:-1;opacity:.42;background:linear-gradient(90deg,transparent 0 12%,var(--block) 12% 19%,transparent 19% 61%,var(--block) 61% 70%,transparent 70%),linear-gradient(0deg,transparent 0 68%,var(--block) 68% 75%,transparent 75%);background-size:240px 180px;image-rendering:pixelated}
    header{position:sticky;top:0;z-index:10;height:76px;padding:0 clamp(22px,5vw,76px);display:flex;align-items:center;justify-content:space-between;background:rgba(241,238,229,.94);border-bottom:var(--pixel) solid rgba(27,29,29,.12)}
    .brand{color:inherit;text-decoration:none;font-size:clamp(18px,2vw,25px);letter-spacing:.28em}
    nav{display:flex;gap:22px}nav a{color:inherit;text-decoration:none;font-size:13px;letter-spacing:.16em;opacity:.62}nav a:hover{opacity:1}
    main{width:min(1060px,calc(100% - 40px));margin:0 auto;padding:90px 0 120px}
    .eyebrow{margin:0 0 14px;color:var(--muted);font-size:12px;letter-spacing:.32em;text-transform:uppercase}
    h1{margin:0;font-size:clamp(44px,7vw,92px);font-weight:500;letter-spacing:.08em}
    .intro{max-width:680px;margin:30px 0 72px;color:var(--muted);font-size:clamp(18px,2vw,25px);line-height:1.8}
    .shelf{margin-top:34px;padding-top:30px;border-top:var(--pixel) solid var(--line)}
    .shelf h2{margin:0 0 24px;font-size:clamp(25px,3vw,38px);font-weight:500;letter-spacing:.08em}
    .book-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:0;padding:0;list-style:none}
    .book{position:relative;min-height:150px;padding:28px 28px 24px;background:var(--paper);border:var(--pixel) solid var(--line);box-shadow:var(--pixel) var(--pixel) 0 rgba(27,29,29,.09)}
    .book::before{content:"";position:absolute;left:calc(var(--pixel)*-1);top:22px;width:var(--pixel);height:44px;background:var(--ink);opacity:.52}
    .book-title{display:block;font-size:25px;line-height:1.45}.book-author{display:block;margin-top:18px;color:var(--muted);font-size:14px;letter-spacing:.12em}
    .empty{padding:24px 0;color:var(--muted);font-size:16px;letter-spacing:.08em}
    .review-link{display:flex;justify-content:space-between;gap:20px;padding:20px 0;color:inherit;text-decoration:none;border-bottom:1px solid var(--line)}
    .review-link:hover{padding-left:var(--pixel)}
    footer{padding:30px;text-align:center;color:var(--muted);font-size:12px;letter-spacing:.22em}
    @media(max-width:680px){header{height:64px}.brand{letter-spacing:.16em}nav{display:none}main{padding-top:58px}.book-list{grid-template-columns:1fr}.intro{margin-bottom:48px}}
    @media(prefers-color-scheme:dark){:root{--paper:#081019;--ink:#e9e7df;--muted:#9da5a7;--line:#2b3941;--block:#0d1b27}}
  </style>
</head>
<body>
  <header>
    <a class="brand" href="index.html">觀心亭拾遺</a>
    <nav><a href="index.html">HOME</a><a href="music.html">MUSIC</a><a href="art.html">ART</a><a href="essays.html">ESSAYS</a></nav>
  </header>
  <main>
    <p class="eyebrow">Reading Room</p>
    <h1>Suzhou Story House</h1>
    <p class="intro">Books currently beside me, books already finished, and notes left behind after reading.</p>

    <section class="shelf">
      <h2>Currently Reading</h2>
      <ul class="book-list">
        <li class="book"><span class="book-title"><i>Lust, Caution</i></span><span class="book-author">Eileen Chang</span></li>
        <li class="book"><span class="book-title"><i>Eight Outcasts</i></span><span class="book-author">Yang Kuisong</span></li>
      </ul>
    </section>

    <section class="shelf">
      <h2>Finished Reading</h2>
      <p class="empty">More books will be added here.</p>
    </section>

    <section class="shelf">
      <h2>Reviews &amp; Reflections</h2>
      <p class="empty">Reading notes and essays will appear here.</p>
      <!-- 将来添加文章时复制：<a class="review-link" href="文章文件名.html"><span>文章标题</span><span>→</span></a> -->
    </section>
  </main>
  <footer>觀心亭拾遺 · SUZHOU STORY HOUSE</footer>
</body>
</html>
